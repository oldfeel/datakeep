# webview_cef（CEF 149）要求 macOS ≥ 12.0
platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
  # webview_cef：嵌入 CEF helper 子进程（多进程渲染）
  require File.expand_path(
    'Flutter/ephemeral/.symlinks/plugins/webview_cef/macos/embed_cef_helpers.rb', __dir__)
  WebviewCEF.install_helper_phase(installer)

  # CocoaPods 会把带空格的 vendored framework 拆坏，典型形态：
  #   -ObjC Embedded Framework -framework "Chromium"
  # 或 -framework "Chromium" Embedded Framework
  # 导致 clang: no such file or directory: 'Embedded' / 'Framework'
  # 见 https://github.com/hlwhl/webview_cef/issues/27
  # 最终写成反斜杠转义（xcconfig 官方空格写法），避免引号在部分 Xcode 下仍被拆开。
  cef_ldflag = '-framework Chromium\\ Embedded\\ Framework'
  fix_cef_ldflags = lambda do |text|
    text
      .gsub(/-ObjC\s+Embedded\s+Framework\s+/, '-ObjC ')
      .gsub(/Embedded\s+Framework\s+(-l)/, '\1')
      .gsub(/-framework\s+"Chromium Embedded Framework"/, cef_ldflag)
      .gsub(/-framework\s+Chromium\\ Embedded\\ Framework/, cef_ldflag)
      .gsub(/-framework\s+"Chromium"\s+Embedded\s+Framework/, cef_ldflag)
      .gsub(/-framework\s+Chromium\s+Embedded\s+Framework/, cef_ldflag)
      .gsub(/-framework\s+"Chromium"(?!\s+Embedded)/, cef_ldflag)
  end

  # Runner 侧清掉可能被写坏的 OTHER_LDFLAGS，只继承 Pods xcconfig
  installer.aggregate_targets.each do |aggregate|
    user_project = aggregate.user_project
    next unless user_project
    dirty = false
    user_project.targets.each do |target|
      target.build_configurations.each do |config|
        flags = config.build_settings['OTHER_LDFLAGS']
        next if flags.nil?
        next if flags == '$(inherited)' || flags == ['$(inherited)']
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited)'
        dirty = true
      end
    end
    user_project.save if dirty
  end

  # 必须在 post_install 末尾改磁盘上的 xcconfig（CocoaPods 已写完）
  Dir.glob(File.join(__dir__, 'Pods/Target Support Files/**/*.xcconfig')).each do |path|
    original = File.read(path)
    fixed = fix_cef_ldflags.call(original)
    if fixed != original
      File.write(path, fixed)
      puts "webview_cef: fixed CEF OTHER_LDFLAGS in #{path.sub(__dir__ + '/', '')}"
    end
  end
end
